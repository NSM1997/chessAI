{
  "manifest_version": 3,
  "name": "Explainable Chess AI",
  "version": "1.0.0",
  "description": "Real-time chess move explanations and analysis",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://chess.com/*",
    "https://www.chess.com/*",
    "https://lichess.org/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chess.com/*",
        "https://www.chess.com/*",
        "https://lichess.org/*"
      ],
      "js": [
        "content-scripts/dom-extractors.js",
        "content-scripts/content-script.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Explainable Chess AI"
  }
}
